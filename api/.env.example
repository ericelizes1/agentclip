# Copy to .env and fill in. .env is gitignored.

# Django core
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database. Leave unset for local sqlite; set for Postgres (Neon in prod).
# DATABASE_URL=postgres://user:pass@host:5432/agentclip

# Redis. Leave unset for local LocMemCache. Set in prod for shared
# rate-limit counters across gunicorn workers + Fly machines (without
# this, "20/h per IP" becomes "20/h × workers × machines"). Upstash
# Redis on Fly.io provides a rediss:// URL out of the box.
# REDIS_URL=rediss://default:xxx@host.upstash.io:6379

# Cloudflare R2 (S3-compatible). Leave unset for local FileSystemStorage.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=agentclip-media
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_PUBLIC_HOST=cdn.agentclip.dev

# Production hardening (only when DEBUG=false)
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_DB_SSLMODE=require
