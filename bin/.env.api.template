# Fly.io secret template for agentclip-api.
#
# `op` resolves the op://... references at deploy time; the values
# never appear in git. To deploy new secret values, edit them in
# 1Password (vault: Personal, item: agentclip), then run:
#
#   bin/sync-secrets.sh api
#
# Required 1Password fields:
# - DJANGO_SECRET_KEY     (long random string)
# - DATABASE_URL          (Neon connection string with ?sslmode=require)
# - REDIS_URL             (Upstash on Fly: rediss://default:xxx@host.upstash.io:6379)
#                          Required in prod for rate limits to share state
#                          across workers + machines. Without it, the
#                          @ratelimit decorators are decorative.
# - R2_ACCESS_KEY_ID      (Cloudflare R2 token id)
# - R2_SECRET_ACCESS_KEY  (Cloudflare R2 secret)
# - R2_BUCKET             (e.g. "agentclip-media")
# - R2_ENDPOINT           (https://<account-id>.r2.cloudflarestorage.com)
# - R2_PUBLIC_HOST        (cdn.agentclip.dev — the Worker route in front of R2)

DJANGO_SECRET_KEY={{ op://Personal/agentclip/DJANGO_SECRET_KEY }}
DATABASE_URL={{ op://Personal/agentclip/DATABASE_URL }}
REDIS_URL={{ op://Personal/agentclip/REDIS_URL }}
R2_ACCESS_KEY_ID={{ op://Personal/agentclip/R2_ACCESS_KEY_ID }}
R2_SECRET_ACCESS_KEY={{ op://Personal/agentclip/R2_SECRET_ACCESS_KEY }}
R2_BUCKET={{ op://Personal/agentclip/R2_BUCKET }}
R2_ENDPOINT={{ op://Personal/agentclip/R2_ENDPOINT }}
R2_PUBLIC_HOST={{ op://Personal/agentclip/R2_PUBLIC_HOST }}
