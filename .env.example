# Copy to .env and fill in. .env is gitignored.

# Django core
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database. Leave unset for local sqlite. Set in prod for Postgres.
# DATABASE_URL=postgres://user:pass@host:5432/qagent

# DigitalOcean Spaces (S3-compatible). Leave unset for local FileSystemStorage.
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=qagent-uploads
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_REGION=nyc3
# DO_SPACES_CUSTOM_DOMAIN=cdn.qagent.app

# Production hardening (only when DEBUG=false)
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_DB_SSLMODE=require
